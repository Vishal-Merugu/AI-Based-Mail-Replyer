PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/mail-replyer
CLIENT_URL=http://localhost:3000

# 32-byte key, hex-encoded (64 hex chars). Generate with: openssl rand -hex 32
# Used to encrypt Gmail OAuth tokens at rest — do not commit a real value.
TOKEN_ENCRYPTION_KEY=

# Signing key for app JWTs. Any long random string. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Stripe — leave blank to run in "free-only" mode (upgrade UI is disabled).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
FREE_PLAN_QUOTA=100
PRO_PLAN_QUOTA=5000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/redirect
GC_TOPIC_NAME=projects/<project-id>/topics/<topic-name>

# Authentication for the Pub/Sub push endpoint (POST /getMessage).
# REQUIRED in production — without one of these the endpoint refuses traffic,
# because an open endpoint lets anyone enqueue work for any connected mailbox.
# Preferred: enable "Authentication" on the push subscription and set the
# audience you configured there.
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Fallback only if OIDC is not an option — append ?token=<value> to the push URL.
PUBSUB_VERIFICATION_TOKEN=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
